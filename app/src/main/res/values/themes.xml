<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题（系统浅色时默认） -->
    <style name="Theme.ESurfing" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 浅色背景要深色图标 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 深色主题：dark 模式下必须深色背景 + 浅色系统栏图标 -->
    <style name="Theme.ESurfing.Dark">
        <item name="android:windowBackground">@drawable/window_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
